{
  "name": "campus-lunch-discord-bot",
  "version": "1.0.2",
  "description": "Discord bot for distributing university lunch menus to multiple Discord servers",
  "main": "src/bot.js",
  "scripts": {
    "start": "node src/bot.js",
    "dev": "NODE_ENV=development node src/bot.js",
    "register": "node scripts/registerGlobalCommands.js",
    "publishNow": "node scripts/publishNow.js",
    "test": "node --test test/",
    "test:watch": "node --test --watch test/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "keywords": [
    "discord",
    "bot",
    "menu",
    "automation"
  ],
  "author": "Campus Lunch Pipeline",
  "license": "MIT",
  "dependencies": {
    "discord.js": "^14.14.0",
    "dotenv": "^16.3.1",
    "node-schedule": "^2.1.1",
    "pg": "^8.11.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^17.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
